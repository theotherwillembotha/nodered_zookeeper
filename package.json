{
  "name": "@theotherwillembotha/node-red-zookeeper",
  "version": "0.2.0",
  "description": "A Zookeeper plugin for Node-RED",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "author": "Willem Botha",
  "license": "ISC",
  "keywords": [
    "node-red",
    "zookeeper",
    "apache-zookeeper"
  ],
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run clean && tsc && npm run generate-nodes && npm run bundle && npm run copy-files",
    "clean": "rm -rf ./build",
    "generate-nodes": "node build/GenerateNodes.js",
    "bundle": "node esbuild.js",
    "copy-files": "cp -r ./icons ./build/"
  },
  "files": [
    "build/",
    "icons/",
    "documentation/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "node-zookeeper-client": "^1.1.3",
    "@theotherwillembotha/node-red-plugincore": "^0.2.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@theotherwillembotha/node-red-plugincore": "../nodered_plugincore",
    "@types/node": "^22.15.16",
    "@types/node-red": "~1.3.5",
    "@types/node-zookeeper-client": "^1.1.0",
    "esbuild": "^0.25.0"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "zookeeper": "./build/Nodes.js"
    },
    "plugins": {
      "zookeeper": "./build/Plugins.js"
    }
  }
}
